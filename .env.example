# SilentSOS Production Environment Variables Configuration Template

# Node Server Environment
NODE_ENV=production
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database Connections
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/silentsos?retryWrites=true&w=majority

# Security Keys & Cryptography
JWT_SECRET=your_production_jwt_master_secret_key_change_me!
REFRESH_SECRET=your_production_refresh_token_secret_key_change_me!
ENCRYPTION_KEY=your_production_32_byte_aes_256_master_key_12345!

# Telephony & SMS Verification (Twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550000000

# Email Delivery Service (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx.yyyyyyyyyyyyyyyy
SENDGRID_FROM_EMAIL=alerts@silentsos.org

# Centralized Error Monitoring (Sentry)
SENTRY_DSN=https://your-dsn@sentry.io/1234567
SENTRY_TRACES_SAMPLE_RATE=1.0

# Logging Level
LOG_LEVEL=info
